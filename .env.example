# Paste your Lemon Squeezy checkout URL here before deploying.
NEXT_PUBLIC_LEMON_SQUEEZY_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-product

# Use the Production project alias from Vercel (free *.vercel.app domain).
NEXT_PUBLIC_SITE_URL=https://saju-destiny-reading.vercel.app

# Transactional report email (Resend). Verify this sender domain in Resend first.
NEXT_PUBLIC_EMAIL_REPORTS_ENABLED=false
RESEND_API_KEY=
SAJU_FROM_EMAIL=SAJU <readings@your-domain.com>

# Required for production email abuse protection (Cloudflare Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared, durable rate limiting for serverless email delivery.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional KakaoTalk Share. This is the JavaScript key, which is public by design.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Lemon Squeezy paid-order webhook (POST /api/lemonsqueezy-webhook).
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_STORE_ID=

# Private SEO dashboard (keep these server-side only).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
